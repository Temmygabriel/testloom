# Required environment variables for Testloom
# Copy this file to .env.local and fill in the values before running locally.

# OpenAI API key — used by the LLM requirement parser (Phase 4)
OPENAI_API_KEY=

# Vercel Blob read/write token — used for evidence screenshot storage (Phase 3+)
# Generate at: https://vercel.com/dashboard/stores/blob
BLOB_READ_WRITE_TOKEN=

# Controlled demo application URLs (set after Phase 1 deployment)
# Version A: session lost on refresh  → produces FAIL verification
DEMO_APP_FAIL_URL=

# Version B: session survives refresh → produces PASS verification
DEMO_APP_PASS_URL=
