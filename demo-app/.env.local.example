# SESSION_MODE controls which session strategy is used.
#
# "cookie"  → session stored in an HttpOnly cookie; survives page refresh.
#             Use this for the PASS deployment (DEMO_APP_PASS_URL).
#
# "memory"  → session stored in a server-side Map; lost on refresh (or any
#             new serverless invocation). Use this for the FAIL deployment
#             (DEMO_APP_FAIL_URL).
#
# Default: "memory" (fail-safe — always demonstrates the broken scenario
# unless explicitly set to "cookie").
SESSION_MODE=memory
